# Copia este archivo como .env y reemplaza los valores de ejemplo.
# Usa el host y puerto de Session pooler de tu proyecto Supabase.
DB_URL=jdbc:postgresql://POOLER_HOST:5432/postgres?sslmode=verify-full
DB_USER=postgres.PROJECT_REF
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
SERVER_PORT=8080
# Origins permitidos en desarrollo web local:
# DEV_WEB_ORIGINS=http://127.0.0.1:8081,http://localhost:8081
# Optional: set to the laptop's Wi-Fi IP only for a local phone demo.
# SERVER_ADDRESS=192.168.1.25
